/* pages/index/index.wxss */
.container {
  width: 100%;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.header {
  width: 100%;
  padding: 40rpx 24rpx 0;
  box-sizing: border-box;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.title-placeholder {
  width: 96rpx;
}

.title-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.info-icon {
  width: 40rpx;
  height: 40rpx;
  margin-left: 16rpx;
}

.history-btn {
  width: 96rpx;
  display: flex;
  justify-content: flex-end;
}

.history-icon {
  width: 48rpx;
  height: 48rpx;
}

.content {
  flex: 1;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 24rpx 0;
  box-sizing: border-box;
}

.current-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.current-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.db-display {
  display: flex;
  align-items: baseline;
}

.db-value {
  font-size: 120rpx;
  font-weight: bold;
  line-height: 1;
}

.db-unit {
  font-size: 36rpx;
  color: #666;
  margin-left: 16rpx;
}

.divider {
  width: 100%;
  height: 2rpx;
  background-color: #e0e0e0;
  margin: 32rpx 0;
}

.statistics-section {
  width: 100%;
  margin-bottom: 32rpx;
}

.statistics-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #666;
  display: block;
  text-align: center;
  margin-bottom: 24rpx;
}

.statistics-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stat-row {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 24rpx;
  font-weight: 600;
}

.progress-section {
  width: 100%;
  margin-top: 32rpx;
  margin-bottom: 0;
}

.progress-labels {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}

.progress-countdown-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  height: 60rpx;
  min-width: 60rpx;
}

.progress-countdown {
  font-size: 60rpx;
  font-weight: bold;
  color: #2E7D32;
  line-height: 60rpx;
}

.progress-bar {
  width: 100%;
  height: 24rpx;
  background-color: #e0e0e0;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background-color: #2E7D32;
  transition: width 0.1s ease;
}

.status-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  display: block;
}

.footer {
  padding: 0 24rpx 32rpx;
  width: 100%;
  box-sizing: border-box;
  margin-top: -60rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.start-btn {
  background-color: #2E7D32;
  color: white;
}

.stop-btn {
  background-color: #F44336;
  color: white;
}

.btn-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
}

/* 测量规则弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-header {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #e0e0e0;
  position: relative;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  flex: 1;
}

.modal-close {
  position: absolute;
  right: 32rpx;
}

.modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
  max-height: 60vh;
  overflow-y: auto;
}

.rule-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.rule-item:last-child {
  margin-bottom: 0;
}

.modal-footer {
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #e0e0e0;
}

.modal-btn {
  width: 100%;
  height: 80rpx;
  background-color: #2E7D32;
  color: white;
  font-size: 32rpx;
  border-radius: 12rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
}
