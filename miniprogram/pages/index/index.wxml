<!--pages/index/index.wxml-->
<view class="container">
  <!-- 标题栏 -->
  <view class="header">
    <view class="title-row">
      <view class="title-placeholder"></view>
      <view class="title-content">
        <text class="title">分贝仪</text>
        <image class="info-icon" src="/images/info.png" bindtap="showMeasurementInfo"></image>
      </view>
      <view class="history-btn" bindtap="navigateToHistory">
        <image class="history-icon" src="/images/history.png"></image>
      </view>
    </view>
  </view>

  <!-- 主要内容 -->
  <view class="content">
    <!-- 当前分贝值 -->
    <view class="current-section">
      <text class="current-label">当前</text>
      <view class="db-display">
        <text class="db-value" style="color: {{currentDbColor}}">{{currentDb}}</text>
        <text class="db-unit">dB</text>
      </view>
    </view>

    <!-- 分隔线 -->
    <view class="divider"></view>

    <!-- 统计信息 -->
    <view class="statistics-section">
      <text class="statistics-title">统计信息</text>
      <view class="statistics-grid">
        <!-- 第一行 -->
        <view class="stat-row">
          <view class="stat-item">
            <text class="stat-label">最小值:</text>
            <text class="stat-value" style="color: {{minDbColor}}">
              {{minDb ? minDb + ' dB' : '-- dB'}}
            </text>
          </view>
          <view class="stat-item">
            <text class="stat-label">平均值:</text>
            <text class="stat-value" style="color: {{avgDbColor}}">
              {{avgDb > 0 ? avgDb + ' dB' : '-- dB'}}
            </text>
          </view>
          <view class="stat-item">
            <text class="stat-label">峰值:</text>
            <text class="stat-value" style="color: {{maxDbColor}}">
              {{maxDb > 0 ? maxDb + ' dB' : '-- dB'}}
            </text>
          </view>
        </view>
        <!-- 第二行 -->
        <view class="stat-row">
          <view class="stat-item">
            <text class="stat-label">P50:</text>
            <text class="stat-value" style="color: {{p50DbColor}}">
              {{p50Db > 0 ? p50Db + ' dB' : '-- dB'}}
            </text>
          </view>
          <view class="stat-item">
            <text class="stat-label">P90:</text>
            <text class="stat-value" style="color: {{p90DbColor}}">
              {{p90Db > 0 ? p90Db + ' dB' : '-- dB'}}
            </text>
          </view>
          <view class="stat-item">
            <text class="stat-label">P95:</text>
            <text class="stat-value" style="color: {{p95DbColor}}">
              {{p95Db > 0 ? p95Db + ' dB' : '-- dB'}}
            </text>
          </view>
        </view>
      </view>
    </view>

    <!-- 进度条 -->
    <view class="progress-section">
      <view class="progress-labels">
        <text class="progress-label">0.0</text>
        <view class="progress-countdown-container">
          <text class="progress-countdown" wx:if="{{countdown > 0}}">{{countdown}}</text>
        </view>
        <text class="progress-label">120.0</text>
      </view>
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{progressWidth}}; background-color: {{progressBarColor}}"></view>
      </view>
      <text class="status-text">{{statusText}}</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="footer">
    <button class="action-btn {{isRecording ? 'stop-btn' : 'start-btn'}}" bindtap="toggleRecording">
      <image class="btn-icon" src="/images/{{isRecording ? 'stop' : 'mic'}}.png"></image>
      <text>{{isRecording ? '停止测量' : '开始测量'}}</text>
    </button>
  </view>

  <!-- 测量规则弹窗 -->
  <view class="modal-mask" wx:if="{{showInfoModal}}" bindtap="hideMeasurementInfo">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">测量规则</text>
        <view class="modal-close" bindtap="hideMeasurementInfo">×</view>
      </view>
      <view class="modal-body">
        <view class="rule-item">• 录音开始3秒后才开始正式测量</view>
        <view class="rule-item">• 此延迟确保麦克风稳定，获得准确读数</view>
        <view class="rule-item">• 统计信息（最小值、平均值、百分位值）仅在3秒延迟后计算</view>
        <view class="rule-item">• 当前分贝值在整个测量过程中实时显示</view>
        <view class="rule-item">• 为获得最佳结果，测量时请保持设备稳定</view>
      </view>
      <view class="modal-footer">
        <button class="modal-btn" bindtap="hideMeasurementInfo">知道了</button>
      </view>
    </view>
  </view>
</view>
